{
  "name": "opensourceapihelper",
  "private": true,
  "version": "1.0.0",
  "description": "Managed LLM key manager + chat client with memory and OS service",
  "main": "electron/main.js",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "electron .",
    "package": "npm run build && electron-builder",
    "package:dir": "npm run build && electron-builder --dir",
    "service:install": "node scripts/service/windows-service.js install",
    "service:uninstall": "node scripts/service/windows-service.js uninstall",
    "audit": "npm audit --audit-level=high && npm audit --audit-level=high -w server && npm audit --audit-level=high -w client"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "build": {
    "appId": "com.ankur.opensourceapihelper",
    "productName": "OpenSourceAPIHelper",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "client/dist/**/*",
      "server/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "server",
        "to": "server",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true
    }
  }
}